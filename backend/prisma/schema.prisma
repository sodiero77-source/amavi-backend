generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Facility {
  id                           String                        @id @default(cuid())
  name                         String
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  residents                    Resident[]
  users                        User[]
  medicationSchedules          MedicationSchedule[]
  medicationAdministrations    MedicationAdministration[]
  treatmentPlansV2             TreatmentPlanV2[]
  treatmentCalendarSessions    TreatmentCalendarSession[]
  clinicalNoteDraftGenerations ClinicalNoteDraftGeneration[]
  noteGenerationAuditLogs      NoteGenerationAuditLog[]
  printSettings                FacilityPrintSettings?
  agencySettings               FacilitySettings?
}

model User {
  id         String   @id @default(cuid())
  facilityId String
  email      String   @unique
  password   String
  fullName   String
  role       UserRole
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model Resident {
  id                           String                        @id @default(cuid())
  facilityId                   String
  firstName                    String
  lastName                     String
  dateOfBirth                  DateTime
  admissionDate                DateTime
  primaryDiagnosis             String?
  secondaryDiagnoses           String[]                      @default([])
  levelOfCare                  String?
  serviceFrequency             String?
  status                       ResidentStatus                @default(ACTIVE)
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  clinicalNotes                ClinicalNote[]
  complianceAlerts             ComplianceAlert[]
  medicationOrders             MedicationOrder[]
  medicationSchedules          MedicationSchedule[]
  medicationAdministrations    MedicationAdministration[]
  facility                     Facility                      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  tasks                        Task[]
  treatmentPlansV2             TreatmentPlanV2[]
  treatmentCalendarSessions    TreatmentCalendarSession[]
  clinicalNoteDraftGenerations ClinicalNoteDraftGeneration[]
  noteGenerationAuditLogs      NoteGenerationAuditLog[]
}

model ClinicalNote {
  id                 String                          @id @default(cuid())
  facilityId         String
  residentId         String
  title              String
  content            String
  status             NoteStatus                      @default(DRAFT)
  createdById        String
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  resident           Resident                        @relation(fields: [residentId], references: [id], onDelete: Cascade)
  treatmentPlanLinks ClinicalNoteTreatmentPlanLink[]
  signature          ClinicalNoteSignature?
}

model MedicationOrder {
  id                      String                     @id @default(cuid())
  facilityId              String
  residentId              String
  medicationName          String
  dose                    String
  route                   String
  frequency               String
  status                  MedicationOrderStatus      @default(DRAFT)
  createdById             String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  resident                Resident                   @relation(fields: [residentId], references: [id], onDelete: Cascade)
  schedules               MedicationSchedule[]
  administrations         MedicationAdministration[]

  @@index([facilityId, residentId])
}

model MedicationSchedule {
  id                      String                     @id @default(cuid())
  facilityId              String
  residentId              String
  medicationOrderId       String
  type                    MedicationScheduleType     @default(SCHEDULED)
  scheduledTime           String?
  scheduledDays           String[]                   @default([])
  startDate               DateTime?
  endDate                 DateTime?
  instructions            String?
  isActive                Boolean                    @default(true)
  createdById             String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  facility                Facility                   @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  resident                Resident                   @relation(fields: [residentId], references: [id], onDelete: Cascade)
  medicationOrder         MedicationOrder            @relation(fields: [medicationOrderId], references: [id], onDelete: Cascade)
  administrations         MedicationAdministration[]

  @@index([facilityId, residentId, isActive])
  @@index([medicationOrderId])
}

model MedicationAdministration {
  id                         String                         @id @default(cuid())
  facilityId                 String
  residentId                 String
  medicationOrderId          String
  scheduleId                 String?
  administrationDate         DateTime
  status                     MedicationAdministrationStatus
  administeredAt             DateTime?
  administeredById           String
  administeredByInitials     String
  notes                      String?
  reason                     String?
  prnIndication              String?
  prnFollowUpAt              DateTime?
  prnEffectiveness           String?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  facility                   Facility                       @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  resident                   Resident                       @relation(fields: [residentId], references: [id], onDelete: Cascade)
  medicationOrder            MedicationOrder                @relation(fields: [medicationOrderId], references: [id], onDelete: Cascade)
  schedule                   MedicationSchedule?            @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([facilityId, residentId, administrationDate])
  @@index([medicationOrderId])
  @@index([scheduleId])
}

model Task {
  id         String     @id @default(cuid())
  facilityId String
  residentId String?
  title      String
  status     TaskStatus @default(OPEN)
  dueAt      DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  resident   Resident?  @relation(fields: [residentId], references: [id])
}

model ComplianceAlert {
  id         String      @id @default(cuid())
  facilityId String
  residentId String?
  title      String
  detail     String
  status     AlertStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  resident   Resident?   @relation(fields: [residentId], references: [id])
}

model TreatmentPlan {
  id         String   @id @default(cuid())
  facilityId String
  residentId String
  problem    String
  goal       String
  objective  String
  createdBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([facilityId])
  @@index([residentId])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  SUPERVISOR
  CLINICIAN
  MEDTECH
  STAFF
}

enum ResidentStatus {
  ACTIVE
  DISCHARGED
}

enum NoteStatus {
  DRAFT
  FINALIZED
  SIGNED
}

enum MedicationOrderStatus {
  DRAFT
  ACTIVE
  HELD
  DISCONTINUED
}

enum MedicationScheduleType {
  SCHEDULED
  PRN
}

enum MedicationAdministrationStatus {
  ADMINISTERED
  REFUSED
  MISSED
  HELD
  OUT_OF_MEDICATION
  MEDICATION_ERROR
}

enum TaskStatus {
  OPEN
  COMPLETED
}

enum AlertStatus {
  OPEN
  RESOLVED
}

enum TreatmentPlanStatus {
  DRAFT
  ACTIVE
  UNDER_REVIEW
  CLOSED
}

enum ObjectiveStatus {
  NOT_STARTED
  IN_PROGRESS
  MET
  DISCONTINUED
}

enum ProgressIndicator {
  PROGRESSING
  MAINTAINING
  REGRESSING
  NOT_ADDRESSED
}

model TreatmentPlanV2 {
  id                           String                        @id @default(cuid())
  facilityId                   String
  residentId                   String
  status                       TreatmentPlanStatus           @default(DRAFT)
  createdById                  String
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  facility                     Facility                      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  resident                     Resident                      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  problems                     TreatmentPlanProblem[]
  treatmentCalendarSessions    TreatmentCalendarSession[]
  clinicalNoteDraftGenerations ClinicalNoteDraftGeneration[]

  @@index([facilityId])
  @@index([residentId])
}

model TreatmentPlanProblem {
  id                           String                        @id @default(cuid())
  treatmentPlanId              String
  description                  String
  createdAt                    DateTime                      @default(now())
  treatmentPlan                TreatmentPlanV2               @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  goals                        TreatmentPlanGoal[]
  treatmentCalendarSessions    TreatmentCalendarSession[]
  clinicalNoteDraftGenerations ClinicalNoteDraftGeneration[]
}

model TreatmentPlanGoal {
  id                           String                        @id @default(cuid())
  problemId                    String
  description                  String
  createdAt                    DateTime                      @default(now())
  problem                      TreatmentPlanProblem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  objectives                   TreatmentPlanObjective[]
  treatmentCalendarSessions    TreatmentCalendarSession[]
  clinicalNoteDraftGenerations ClinicalNoteDraftGeneration[]
}

model TreatmentPlanObjective {
  id                           String                          @id @default(cuid())
  goalId                       String
  description                  String
  status                       ObjectiveStatus                 @default(NOT_STARTED)
  targetDate                   DateTime?
  createdAt                    DateTime                        @default(now())
  goal                         TreatmentPlanGoal               @relation(fields: [goalId], references: [id], onDelete: Cascade)
  noteLinks                    ClinicalNoteTreatmentPlanLink[]
  treatmentCalendarSessions    TreatmentCalendarSession[]
  clinicalNoteDraftGenerations ClinicalNoteDraftGeneration[]
}

model ClinicalNoteTreatmentPlanLink {
  id                String                 @id @default(cuid())
  noteId            String
  objectiveId       String
  progressIndicator ProgressIndicator
  createdAt         DateTime               @default(now())
  note              ClinicalNote           @relation(fields: [noteId], references: [id], onDelete: Cascade)
  objective         TreatmentPlanObjective @relation(fields: [objectiveId], references: [id])

  @@unique([noteId, objectiveId])
}

model ClinicalNoteSignature {
  id         String       @id @default(cuid())
  noteId     String       @unique
  signedById String
  signedAt   DateTime     @default(now())
  note       ClinicalNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
}

model TreatmentCalendarSession {
  id                    String                        @id @default(cuid())
  facilityId            String
  residentId            String
  treatmentPlanId       String
  problemId             String
  goalId                String
  objectiveId           String
  serviceType           String
  sessionTopic          String
  interventionCategory  String?
  expectedProgressFocus String?
  suggestedPrompt       String?
  progressionRationale  String?
  diagnosisRationale    Json?
  topicRotationKey      String?
  calendarMonth         String?
  scheduledFor          DateTime
  createdById           String
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt
  facility              Facility                      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  resident              Resident                      @relation(fields: [residentId], references: [id], onDelete: Cascade)
  treatmentPlan         TreatmentPlanV2               @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  problem               TreatmentPlanProblem          @relation(fields: [problemId], references: [id])
  goal                  TreatmentPlanGoal             @relation(fields: [goalId], references: [id])
  objective             TreatmentPlanObjective        @relation(fields: [objectiveId], references: [id])
  generations           ClinicalNoteDraftGeneration[]

  @@index([facilityId, residentId, scheduledFor])
  @@index([treatmentPlanId])
  @@index([problemId, goalId, objectiveId])
}

model ClinicalNoteDraftGeneration {
  id                         String                    @id @default(cuid())
  facilityId                 String
  residentId                 String
  treatmentPlanId            String
  problemId                  String
  goalId                     String
  objectiveId                String
  treatmentCalendarSessionId String?
  serviceType                String
  sessionTopic               String
  staffId                    String
  promptInput                Json
  generatedOutput            Json
  regenerationCount          Int                       @default(0)
  reviewedById               String?
  reviewedAt                 DateTime?
  createdById                String
  requestId                  String
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  facility                   Facility                  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  resident                   Resident                  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  treatmentPlan              TreatmentPlanV2           @relation(fields: [treatmentPlanId], references: [id], onDelete: Cascade)
  problem                    TreatmentPlanProblem      @relation(fields: [problemId], references: [id])
  goal                       TreatmentPlanGoal         @relation(fields: [goalId], references: [id])
  objective                  TreatmentPlanObjective    @relation(fields: [objectiveId], references: [id])
  treatmentCalendarSession   TreatmentCalendarSession? @relation(fields: [treatmentCalendarSessionId], references: [id])
  auditLogs                  NoteGenerationAuditLog[]

  @@index([facilityId, residentId, createdAt])
  @@index([treatmentPlanId])
  @@index([problemId, goalId, objectiveId])
}

model NoteGenerationAuditLog {
  id           String                       @id @default(cuid())
  facilityId   String
  residentId   String
  generationId String?
  action       String
  actorId      String
  actorRole    String
  requestId    String
  metadata     Json
  createdAt    DateTime                     @default(now())
  facility     Facility                     @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  resident     Resident                     @relation(fields: [residentId], references: [id], onDelete: Cascade)
  generation   ClinicalNoteDraftGeneration? @relation(fields: [generationId], references: [id])

  @@index([facilityId, residentId, createdAt])
  @@index([generationId])
}

model FacilityPrintSettings {
  id                                   String   @id @default(cuid())
  facilityId                           String   @unique
  facilityLegalName                    String?
  dbaName                              String?
  address                              String?
  phone                                String?
  licenseNumber                        String?
  logoUrl                              String?
  footerDisclaimer                     String?
  printedNoteTitle                     String   @default("Clinical Note Draft")
  showAiDraftDisclaimerOnPrintedDrafts Boolean  @default(true)
  showStaffCredentials                 Boolean  @default(true)
  showTreatmentPlanLinkageSection      Boolean  @default(true)
  showAuditMetadataSection             Boolean  @default(true)
  createdAt                            DateTime @default(now())
  updatedAt                            DateTime @updatedAt
  facility                             Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}

model FacilitySettings {
  id                         String   @id @default(cuid())
  facilityId                 String   @unique
  companyName                String
  providerNpiOrTaxNumber     String
  email                      String
  logoUrl                    String?
  programType                String
  addressLine1               String
  addressLine2               String?
  city                       String
  state                      String
  postalCode                 String
  timeZone                   String
  shifts                     String[] @default([])
  servicesProvided           String[] @default([])
  levelsOfFunctioning        String[] @default([])
  urgentNotificationEmails   String[] @default([])
  residentAttendanceOptions  String[] @default([])
  clientLabel                String
  residentReportLabel        String
  governingBodyLabel         String
  residentIdLabel            String
  secondaryResidentIdLabel   String?
  serviceCoordinatorLabel    String
  evaluatorLeadLabel         String
  goalsLabel                 String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  facility                   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
}
